NODE_ENV=development
PORT=3001
HOST=0.0.0.0
DATABASE_URL=postgresql://user:password@localhost:5432/vuela_events
# Rol con permisos DDL (crear/alterar tablas), solo para el paso de migrar al desplegar.
# En runtime la app usa DATABASE_URL (rol restringido, solo CRUD).
MIGRATE_DATABASE_URL=postgres://usuario_owner:password@host:5432/vuela_events
SESSION_SECRET=change-me-min-32-chars
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
ALLOWED_EMAIL_DOMAIN=puntosvuela.es
FRONTEND_ORIGIN=http://localhost:3000
SUPERADMIN_EMAIL=tu-correo@puntosvuela.es
TRUST_PROXY_HOPS=0
APP_PASSWORD_ENC_KEY=change-me-min-32-chars