model ResourceLink {
    id              String          @id @default(uuid()) @db.Uuid
    title           String          @unique @db.VarChar(100)
    url             String          @db.VarChar(2048)
    active          Boolean         @default(true)
    createdAt       DateTime        @default(now())
    updatedAt       DateTime        @updatedAt

    @@map("resource_links")
}