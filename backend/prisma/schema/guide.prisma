model Guide {
    id              String          @id @default(uuid()) @db.Uuid
    name            String          @unique @db.VarChar(100)
    url             String          @db.VarChar(2048)
    active          Boolean         @default(true)
    createdAt       DateTime        @default(now())
    updatedAt       DateTime        @updatedAt
    events          Event[]

    @@map("guides")
}